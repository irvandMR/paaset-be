{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch tjus-be",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/tjus/main.go",
            "cwd": "${workspaceFolder}",
            "env": {
                "DB_URL": "postgresql://postgres:postgres@localhost:5433/tjus_db_dev?sslmode=disable",
                "REDIS_ADDR": "localhost:6380",
                "APP_ENV": "development"
            }
        }
    ]
}